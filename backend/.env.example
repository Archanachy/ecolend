# EcoLend backend configuration — template.
# Copy to .env and fill in real values. NEVER commit .env itself.
#   cp .env.example .env

# --- Database ---
# Atlas connection string. The connecting machine's public IP must be in the
# cluster's Network Access allowlist, or the TLS handshake is refused.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecolend?retryWrites=true&w=majority

# --- Sessions ---
# Long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Field encryption (AES-256-GCM) ---
# EXACTLY 64 hex characters (256-bit). Generate ONCE with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# WARNING: never change this after data exists. Phone numbers, addresses and
# MFA secrets are encrypted with it and become permanently unrecoverable.
FIELD_ENC_KEY=

# --- Origins ---
# APP_URL is the frontend origin (email links + Khalti website_url).
# BACKEND_URL is this API's origin (used to build the Khalti return_url).
APP_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# --- Khalti ---
# KHALTI_ENV selects the base URL (sandbox -> dev.khalti.com). Never hardcode it.
# In dev, KHALTI_SECRET_KEY is the live_secret_key from test-admin.khalti.com
# (valid only against the dev.khalti.com sandbox).
KHALTI_ENV=sandbox
KHALTI_SECRET_KEY=

# --- Admin IP allowlist ---
# Comma-separated IPs exempt from the automatic IP *block* only. These are
# never exempt from authentication, MFA or RBAC. Leave empty if unused.
ADMIN_IP_ALLOWLIST=

# --- hCaptcha ---
# hCaptcha's official public test keys are below: they always verify, which is
# what you want in development. Swap for real keys in production.
# If these are blank, CAPTCHA-protected routes fail CLOSED (500) by design.
CAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
CAPTCHA_SECRET_KEY=0x0000000000000000000000000000000000000000

# --- Mail transport ---
# Leave MAIL_HOST blank to fall back to a console transport (dev only) — no
# real email is sent and verification links are printed to the server log.
# For Gmail: enable 2-Step Verification, then create an App Password
# (16 characters, no spaces) and use it as MAIL_PASS. Your normal Google
# password will not work.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
