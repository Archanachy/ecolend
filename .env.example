# EcoLend environment. Copy to `.env` and fill real values.
# `.env` is git-ignored and must NEVER be committed. This file ships
# placeholders only.

# --- Database ---
MONGODB_URI=mongodb://mongo:27017/ecolend

# --- Sessions ---
SESSION_SECRET=replace-with-a-long-random-string

# --- Field-level encryption (AES-256-GCM) ---
# 256-bit key, hex-encoded (64 hex chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENC_KEY=replace-with-64-hex-chars

# --- App URLs ---
# APP_URL is the frontend origin (used for email links + Khalti website_url).
# BACKEND_URL is this API's origin (used to build the Khalti return_url).
APP_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# --- Khalti (sandbox) ---
# KHALTI_ENV selects the base URL (sandbox -> dev.khalti.com). Never hardcode the URL.
# In dev, KHALTI_SECRET_KEY is the live_secret_key from test-admin.khalti.com
# (valid only against the dev.khalti.com sandbox).
KHALTI_ENV=sandbox
KHALTI_SECRET_KEY=replace-with-sandbox-secret-key

# --- Brute-force / admin allow-list ---
ADMIN_IP_ALLOWLIST=

# --- CAPTCHA (hCaptcha) ---
# Required: always on /register, and on /login after 3 failed attempts.
# There is NO bypass — a missing secret makes those endpoints fail closed.
# hCaptcha publishes test keys that always pass, for local dev/demo:
#   site   = 10000000-ffff-ffff-ffff-000000000001
#   secret = 0x0000000000000000000000000000000000000000
# The frontend obtains this public site key from GET /api/captcha/config, so the
# Docker setup does not need a separate frontend environment file.
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# --- Mail transport (email verification / password reset) ---
# Leave MAIL_HOST blank to use the dev console transport (prints emails to
# stdout). Set these to send real mail via SMTP. Port 465 = implicit TLS,
# 587 = STARTTLS. Never commit real credentials — keep them in .env only.
# Example (Mailtrap sandbox): host=sandbox.smtp.mailtrap.io port=2525
# Example (Gmail): host=smtp.gmail.com port=587 user=you@gmail.com pass=<app password>
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@ecolend.local
